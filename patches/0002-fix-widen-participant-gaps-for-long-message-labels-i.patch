From 9005d9abe193e483c4d3ce7f1c73e2fd9d4cc192 Mon Sep 17 00:00:00 2001
From: hsgamer <huynhqtienvtag@gmail.com>
Date: Sat, 21 Feb 2026 18:13:45 +0700
Subject: [PATCH 2/2] fix: widen participant gaps for long message labels in
 sequence diagrams

---
 src/layout/sequence.rs | 24 +++++++++++-------------
 1 file changed, 11 insertions(+), 13 deletions(-)

diff --git a/src/layout/sequence.rs b/src/layout/sequence.rs
index c103d80..6431892 100644
--- a/src/layout/sequence.rs
+++ b/src/layout/sequence.rs
@@ -124,19 +124,17 @@ fn compute_sequence_lane_centers(
             continue;
         }
 
-        if let Some(label) = edge.label.as_ref() {
-            let block = measure_sequence_text(label, theme, config);
-            let base_center = if left_idx == 0 {
-                geometry.actor_min_width * 0.5
-            } else {
-                geometry.actor_min_width * 0.5 + pitches.iter().take(left_idx).sum::<f32>()
-            };
-            let default_mid_x = base_center + geometry.lane_pitch * 0.5;
-            let max_label_x = default_mid_x + block.width * 0.5;
-            let right_min_center = max_label_x + geometry.note_gap_x;
-            let current_right_center = base_center + pitches[left_idx];
-            pitches[left_idx] = pitches[left_idx].max(right_min_center - base_center);
-            pitches[left_idx] = pitches[left_idx].max(current_right_center - base_center);
+        let mut max_label_w = 0.0f32;
+        for label_opt in &[&edge.label, &edge.start_label, &edge.end_label] {
+            if let Some(label) = label_opt {
+                let block = measure_sequence_text(label, theme, config);
+                max_label_w = max_label_w.max(block.width);
+            }
+        }
+
+        if max_label_w > 0.0 {
+            let label_pad = theme.font_size * 1.2;
+            pitches[left_idx] = pitches[left_idx].max(max_label_w + label_pad);
         }
     }
 
