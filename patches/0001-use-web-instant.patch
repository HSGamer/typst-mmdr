From 12b97aeb027c4a92a8999bd369fabae2d9db59ea Mon Sep 17 00:00:00 2001
From: hsgamer <huynhqtienvtag@gmail.com>
Date: Sun, 8 Mar 2026 23:18:17 +0700
Subject: [PATCH 1/2] use web-instant

---
 Cargo.lock        | 9 +++++++++
 Cargo.toml        | 1 +
 src/layout/mod.rs | 3 ++-
 src/lib.rs        | 2 +-
 4 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 13f9795..f8519cc 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -445,6 +445,15 @@ version = "0.14.0"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "09e54e57b4c48b40f7aec75635392b12b3421fa26fe8b4332e63138ed278459c"
 
+[[package]]
+name = "instant"
+version = "0.1.13"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "e0242819d153cba4b4b05a5a8f2a7e9bbf97b6055b2a002b395c96b5ff3c0222"
+dependencies = [
+ "cfg-if",
+]
+
 [[package]]
 name = "is_terminal_polyfill"
 version = "1.70.2"
diff --git a/Cargo.toml b/Cargo.toml
index 23318c3..f242048 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -41,6 +41,7 @@ fontdb = "0.23"
 ttf-parser = "0.25"
 resvg = { version = "0.46", optional = true }
 usvg = { version = "0.46", optional = true }
+instant = "0.1"
 
 [dev-dependencies]
 criterion = "0.8"
diff --git a/src/layout/mod.rs b/src/layout/mod.rs
index 44e533a..e50057c 100644
--- a/src/layout/mod.rs
+++ b/src/layout/mod.rs
@@ -48,7 +48,8 @@ use crate::text_metrics;
 use crate::theme::{Theme, adjust_color, parse_color_to_hsl};
 use std::cmp::Ordering;
 use std::collections::{BTreeMap, HashMap, HashSet};
-use std::time::Instant;
+
+use instant::Instant;
 
 // Label placement padding (resolved per diagram kind).
 const LABEL_RANK_FONT_SCALE: f32 = 0.5;
diff --git a/src/lib.rs b/src/lib.rs
index c1d00a9..7b5aa4a 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -306,7 +306,7 @@ pub fn render_with_detailed_timing(
     input: &str,
     options: RenderOptions,
 ) -> anyhow::Result<RenderDetailedResult> {
-    use std::time::Instant;
+    use instant::Instant;
 
     let t0 = Instant::now();
     let parsed = parse_mermaid(input)?;
