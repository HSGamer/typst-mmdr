From 9b95c404217bbbac8ce4ca5816a427388989fc93 Mon Sep 17 00:00:00 2001
From: hsgamer <huynhqtienvtag@gmail.com>
Date: Sat, 21 Feb 2026 17:59:28 +0700
Subject: [PATCH 1/3] use web-instant

---
 Cargo.lock        | 10 ++++++++++
 Cargo.toml        |  1 +
 src/layout/mod.rs |  3 ++-
 src/lib.rs        |  2 +-
 4 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index a0609ca..3eb7da2 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -507,6 +507,15 @@ version = "0.14.0"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "09e54e57b4c48b40f7aec75635392b12b3421fa26fe8b4332e63138ed278459c"
 
+[[package]]
+name = "instant"
+version = "0.1.13"
+source = "registry+https://github.com/rust-lang/crates.io-index"
+checksum = "e0242819d153cba4b4b05a5a8f2a7e9bbf97b6055b2a002b395c96b5ff3c0222"
+dependencies = [
+ "cfg-if",
+]
+
 [[package]]
 name = "is_terminal_polyfill"
 version = "1.70.2"
@@ -601,6 +610,7 @@ dependencies = [
  "clap",
  "criterion",
  "fontdb 0.16.2",
+ "instant",
  "json5",
  "once_cell",
  "regex",
diff --git a/Cargo.toml b/Cargo.toml
index 22b04d1..31b96c7 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -41,6 +41,7 @@ fontdb = "0.16"
 ttf-parser = "0.20"
 resvg = { version = "0.46", optional = true }
 usvg = { version = "0.46", optional = true }
+instant = "0.1"
 
 [dev-dependencies]
 criterion = "0.8"
diff --git a/src/layout/mod.rs b/src/layout/mod.rs
index 44e533a..e50057c 100644
--- a/src/layout/mod.rs
+++ b/src/layout/mod.rs
@@ -48,7 +48,8 @@ use crate::text_metrics;
 use crate::theme::{Theme, adjust_color, parse_color_to_hsl};
 use std::cmp::Ordering;
 use std::collections::{BTreeMap, HashMap, HashSet};
-use std::time::Instant;
+
+use instant::Instant;
 
 // Label placement padding (resolved per diagram kind).
 const LABEL_RANK_FONT_SCALE: f32 = 0.5;
diff --git a/src/lib.rs b/src/lib.rs
index c1d00a9..7b5aa4a 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -306,7 +306,7 @@ pub fn render_with_detailed_timing(
     input: &str,
     options: RenderOptions,
 ) -> anyhow::Result<RenderDetailedResult> {
-    use std::time::Instant;
+    use instant::Instant;
 
     let t0 = Instant::now();
     let parsed = parse_mermaid(input)?;
